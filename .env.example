# Local development overrides (optional)
POSTGRES_DB=hermes_policy
POSTGRES_USER=hermes
POSTGRES_PASSWORD=hermes
POSTGRES_DSN=postgres://hermes:hermes@localhost:5432/hermes_policy?sslmode=disable
GATEWAY_LISTEN_ADDR=:8080
GATEWAY_PROXY_ENABLED=true
GATEWAY_ORG_ID=11111111-1111-1111-1111-111111111010
GATEWAY_USER_ID=11111111-1111-1111-1111-111111111001
GATEWAY_AGENT_ID=11111111-1111-1111-1111-111111111020
GATEWAY_ADMIN_ID=11111111-1111-1111-1111-111111111002
# Required for remember=true org rules and POST /api/v1/rules (Phase 3+)
GATEWAY_ADMIN_TOKEN=dev-local-admin-token
# Allow proxy clients to send X-Gateway-Agent-Id / X-Gateway-User-Id (dev only)
GATEWAY_ALLOW_IDENTITY_OVERRIDE=true
# GATEWAY_AGENT_ID_HEADER=X-Gateway-Agent-Id
# GATEWAY_USER_ID_HEADER=X-Gateway-User-Id
# GATEWAY_APPROVER_HEADER=X-Gateway-Approver
# TEST_POSTGRES_DSN=postgres://hermes:hermes@localhost:5432/hermes_policy?sslmode=disable

# Hermes agent image (Phase 4)
HERMES_AGENT_REF=v2026.8.18
HERMES_AGENT_SHA=e624e9fde561e1add9388384012b295fde669ade

# Phase 4.1 pilot profile (make up-pilot) — model egress allowlist
MODEL_EGRESS_ALLOW_HOSTS=api.openai.com,api.anthropic.com,openrouter.ai,auth.openai.com,chatgpt.com
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Control-plane authentication (Phase 5.13) ---------------------------
# dev-token: the shared GATEWAY_ADMIN_TOKEN above. Convenient locally, but it
#            cannot attribute an action to a person - every audit entry records
#            the same administrator - so the gateway warns loudly at startup.
# oidc:      operators sign in through your identity provider. Clearance
#            verifies the token and looks the person up in its own directory;
#            roles come from actors.role, never from a token claim.
CLEARANCE_AUTH_MODE=dev-token

# Required when CLEARANCE_AUTH_MODE=oidc. Provider-neutral: Entra ID, Google,
# Auth0, Keycloak, and Okta all work through standard OIDC discovery.
#   OIDC_ISSUER_URL=https://login.microsoftonline.com/<tenant>/v2.0
#   OIDC_CLIENT_ID=<application-id>
# Set OIDC_AUDIENCE only when access tokens are issued for an API audience
# distinct from the client id.
#   OIDC_AUDIENCE=

# --- TLS termination (optional) -----------------------------------------
# Both or neither; setting one without the other is rejected at startup rather
# than silently serving plaintext. TLS 1.2 floor.
#   CLEARANCE_TLS_CERT_FILE=/etc/clearance/tls/tls.crt
#   CLEARANCE_TLS_KEY_FILE=/etc/clearance/tls/tls.key
